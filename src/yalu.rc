// Yalu Windows Resource Script
#include <windows.h>

// Main Application Icon (ID 1 ensures Windows Explorer uses this as the executable icon)
1 ICON "yalu.ico"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,3,0,0
PRODUCTVERSION  0,3,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef YALU_DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Yalu Project\0"
            VALUE "FileDescription",  "Yalu Programming Language Interpreter\0"
            VALUE "FileVersion",      "0.3.0.0\0"
            VALUE "InternalName",     "yalu\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Alireza T. (Opuntake)\0"
            VALUE "OriginalFilename", "yalu.exe\0"
            VALUE "ProductName",      "Yalu Programming Language\0"
            VALUE "ProductVersion",   "0.3.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
