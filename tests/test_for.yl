<<"" Test 08: For Loops, Ranges, Inclusive Upper Bound, Step "">>
pr "standard range 1@5:"
fr !!i in 1@5!! ::
    pr "i = /#i"
::

pr "step range 0@10@2:"
fr !!n in 0@10@2!! ::
    pr "n = /#n"
::

pr "downward range 5@1:"
fr !!d in 5@1!! ::
    pr "d = /#d"
::

pr "for loop with break at 3:"
fr !!x in 1@10!! ::
    if !!x == 3!! ::
        bk
    ::
    pr "x = /#x"
::

